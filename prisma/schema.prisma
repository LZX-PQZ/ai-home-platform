generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(cuid())
  name String
  role String @default("owner")
  providerId String? @unique
  provider ServiceProvider? @relation("ProviderAccount", fields: [providerId], references: [id])
  demands DemandOrder[]
  demoSessions DemoProviderSession[]
  ownerSessions OwnerSession[]
}
model OwnerSession {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  @@index([userId])
  @@index([expiresAt])
}
model DemoProviderSession {
  tokenHash String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([expiresAt])
}
model DemandOrder {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  description String
  city String
  areaM2 Float
  budgetMinCents Int
  budgetMaxCents Int
  renovationType String
  desiredDays Int
  status String @default("draft")
  createdAt DateTime @default(now())
  quotes Quote[]
  schedules Schedule[]
  payments Payment[]
  reviews Review[]
  tickets Ticket[]
}
model ServiceProvider {
  id String @id @default(cuid())
  name String
  city String
  kind String
  tagsJson String
  rating Float @default(0)
  quotes Quote[]
  account User? @relation("ProviderAccount")
  quoteSubmissionReceipts QuoteSubmissionReceipt[]
}
model Quote {
  id String @id @default(cuid())
  demandId String
  demand DemandOrder @relation(fields: [demandId], references: [id])
  providerId String
  provider ServiceProvider @relation(fields: [providerId], references: [id])
  itemsJson String
  knownTotalCents Int
  pendingItemsJson String
  estimatedDays Int
  status String @default("draft")
  submissionReceipt QuoteSubmissionReceipt?
}
model QuoteSubmissionReceipt {
  id String @id @default(cuid())
  providerId String
  provider ServiceProvider @relation(fields: [providerId], references: [id])
  idempotencyKey String
  requestHash String
  quoteId String @unique
  quote Quote @relation(fields: [quoteId], references: [id])
  createdAt DateTime @default(now())
  @@unique([providerId, idempotencyKey])
}
model Schedule {
  id String @id @default(cuid())
  demandId String
  demand DemandOrder @relation(fields: [demandId], references: [id])
  version Int @default(1)
  tasksJson String
  @@unique([demandId, version])
}
model Payment {
  id String @id @default(cuid())
  demandId String
  demand DemandOrder @relation(fields: [demandId], references: [id])
  stage String
  amountCents Int
  status String @default("pending")
  simulated Boolean @default(true)
}
model Review {
  id String @id @default(cuid())
  demandId String
  demand DemandOrder @relation(fields: [demandId], references: [id])
  providerId String
  rating Int
  comment String
}
model Ticket {
  id String @id @default(cuid())
  demandId String
  demand DemandOrder @relation(fields: [demandId], references: [id])
  description String
  category String
  responsibleProviderId String?
  status String @default("open")
}
